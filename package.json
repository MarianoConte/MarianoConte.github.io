    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cypress": "^16.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.1",
    "jsdom": "^30.1.2",
    "serve": "^14.2.6",
